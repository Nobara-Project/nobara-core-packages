[Unit]
Description=Install the prepared Nobara system update
DefaultDependencies=no
Requires=sysinit.target
After=sysinit.target systemd-journald.socket system-update-pre.target plymouth-start.service
Before=system-update.target shutdown.target
OnFailure=nobara-updater-recovery.service
RefuseManualStop=yes

[Service]
Type=oneshot
ExecCondition=/usr/libexec/nobara-update-worker own-trigger
# Ctrl+Alt+Del would reboot in the middle of installation or boot-file
# validation. The runtime mask ends with this boot; a burst of presses still
# forces a reboot (CtrlAltDelBurstAction).
ExecStartPre=-/usr/bin/systemctl mask --runtime ctrl-alt-del.target
ExecStart=/usr/libexec/nobara-update-worker execute
ExecStartPost=/usr/bin/systemctl --no-block reboot
ExecStopPost=-/usr/libexec/nobara-update-worker offline-stopped
TimeoutStartSec=infinity
TimeoutStopSec=infinity
UMask=0077
IPAddressDeny=any
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=system-update.target
