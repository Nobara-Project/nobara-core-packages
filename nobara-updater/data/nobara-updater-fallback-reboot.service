[Unit]
Description=Restart into an armed Nobara recovery system
DefaultDependencies=no
After=nobara-updater-recovery.service
RequiresMountsFor=/boot
ConditionPathExists=/boot/nobara-updater/recovery-armed
# A shell helper restores the private boot entry and consumes one durable
# restart ticket per job, including when the Python worker cannot run.
OnFailure=emergency.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/nobara-update-reboot
TimeoutStartSec=60s
